{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": ["html"],
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off",
    "no-undef": "warn",
    "no-empty": "warn"
  },
  "globals": {
    "SpreadsheetApp": "readonly",
    "ContentService": "readonly",
    "Utilities": "readonly",
    "UrlFetchApp": "readonly",
    "Logger": "readonly"
  }
}
