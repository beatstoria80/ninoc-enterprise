# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=enterprise_db

# Security
KMS_MASTER_KEY=your_32_byte_hex_key_here_at_least_64_chars
ARGON2_SECRET=some_secret_pepper

# App Config
PORT=3000
NODE_ENV=development
ENCRYPTION_SECRET=your_secret_key_min_32_chars_long

# Midtrans Configuration (Payment Gateway)
# Ambil dari Dashboard Midtrans: Settings -> Access Keys
# Gunakan Server Key & Client Key dari Environment SANDBOX atau PRODUCTION
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Legal Compliance
PSE_REGISTRATION_NUMBER=000842/DJAI.PSE/01/2025
COMPANY_LEGAL_NAME=NINOC Enterprise Indonesia
